#!/usr/bin/env bash
# Runs inside cage (a one-app Wayland compositor) on the Pi's own screen: rotate the panel,
# wait for dashd, then show the dash full screen in Chromium. Started by glassdash-kiosk.service.
# Settings: /etc/glassdash/kiosk.env
#   KIOSK_ROTATE=90     0, 90, 180 or 270. Touch Display 2 is portrait (720x1280); 90 or 270 = landscape
#   KIOSK_URL=https://localhost:8000
set -uo pipefail

KIOSK_ROTATE=90
KIOSK_URL=https://localhost:8000
# shellcheck disable=SC1091
[ -f /etc/glassdash/kiosk.env ] && . /etc/glassdash/kiosk.env

# Rotate the DSI panel (the Touch Display). HDMI screens are left as they are.
if command -v wlr-randr >/dev/null; then
  out="$(wlr-randr 2>/dev/null | awk '/^DSI/{print $1; exit}')"
  if [ -n "$out" ] && [ "$KIOSK_ROTATE" != 0 ]; then
    wlr-randr --output "$out" --transform "$KIOSK_ROTATE" || echo "warning: couldn't rotate $out" >&2
  fi
fi

# dashd takes a few seconds to start (and up to a minute at boot while CAN bring-up waits for the HAT).
for _ in $(seq 120); do
  curl -sfo /dev/null "$KIOSK_URL/" && break
  sleep 1
done

exec chromium --kiosk --app="$KIOSK_URL" \
  --ozone-platform=wayland --password-store=basic \
  --user-data-dir="$HOME/.config/glassdash-kiosk" \
  --no-first-run --noerrdialogs --disable-infobars --disable-session-crashed-bubble \
  --disable-features=Translate,TouchpadOverscrollHistoryNavigation \
  --overscroll-history-navigation=0 --disable-pinch \
  --check-for-update-interval=31536000
