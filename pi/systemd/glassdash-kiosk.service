[Unit]
Description=glassdash on the Pi's own screen (cage + Chromium kiosk)
# Optional: installed and enabled by `setup.sh --kiosk`. The iPad doesn't need it.
After=systemd-user-sessions.service glassdash.service getty@tty1.service
Wants=glassdash.service
Conflicts=getty@tty1.service

[Service]
User=kiosk
PAMName=login
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty-fail
StandardOutput=journal
StandardError=journal
UtmpIdentifier=tty1
UtmpMode=user
Environment=XDG_SESSION_TYPE=wayland
ExecStart=/usr/bin/cage -d -- /usr/local/bin/glassdash-kiosk
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
